rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCanonicalInternalUserId(value) {
      return value is string && value.matches('^gw_usr_[a-z0-9]{20,}$');
    }

    function canonicalAppUserId() {
      return isCanonicalInternalUserId(request.auth.uid)
        ? request.auth.uid
        : isCanonicalInternalUserId(request.auth.token.gitwall_user_id)
          ? request.auth.token.gitwall_user_id
          : isCanonicalInternalUserId(request.auth.token.internal_user_id)
            ? request.auth.token.internal_user_id
            : isCanonicalInternalUserId(request.auth.token.app_user_id)
              ? request.auth.token.app_user_id
              : null;
    }

    function verifiedGithubEmail() {
      return request.auth.token.github_email is string
        ? request.auth.token.github_email
        : null;
    }

    function githubProviderId() {
      return request.auth.token.github_provider_id is string
        ? request.auth.token.github_provider_id
        : null;
    }

    function isGitWallCustomSession() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider is string
        && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function isAppUserSession() {
      return isGitWallCustomSession()
        && canonicalAppUserId() is string;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.enabled != false;
    }

    function isOwnCanonicalUserDoc(userId) {
      return isAppUserSession()
        && canonicalAppUserId() == userId;
    }

    function isOwnLegacyEmailUserDoc(userId) {
      return isGitWallCustomSession()
        && verifiedGithubEmail() is string
        && verifiedGithubEmail() == userId;
    }

    function isAllowedCanonicalUserWrite(userId) {
      return isOwnCanonicalUserDoc(userId)
        && request.resource.data.internalUserId == canonicalAppUserId()
        && (!request.resource.data.keys().hasAny(['appUserId'])
          || request.resource.data.appUserId == canonicalAppUserId())
        && (!request.resource.data.keys().hasAny(['firebaseUid'])
          || request.resource.data.firebaseUid == canonicalAppUserId())
        && (!request.resource.data.keys().hasAny(['githubProviderId'])
          || githubProviderId() == null
          || request.resource.data.githubProviderId == githubProviderId());
    }

    function isOwnEmailLinkDoc(email) {
      return isGitWallCustomSession()
        && verifiedGithubEmail() is string
        && verifiedGithubEmail() == email;
    }

    function isOwnGithubLinkDoc(providerId) {
      return isGitWallCustomSession()
        && githubProviderId() is string
        && githubProviderId() == providerId;
    }

    function isOwnLegacyLinkDoc(legacyId) {
      return isSignedIn()
        && request.auth.uid is string
        && request.auth.uid == legacyId;
    }

    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isOwnCanonicalUserDoc(userId)
        || isOwnLegacyEmailUserDoc(userId);
      allow create, update: if isAdmin() || isAllowedCanonicalUserWrite(userId);
      allow delete: if isAdmin();
    }

    match /identity_links_email/{email} {
      allow read: if isAdmin() || isOwnEmailLinkDoc(email);
      allow write: if isAdmin();
    }

    match /identity_links_github/{providerId} {
      allow read: if isAdmin() || isOwnGithubLinkDoc(providerId);
      allow write: if isAdmin();
    }

    match /legacy_identity_links/{legacyId} {
      allow read: if isAdmin() || isOwnLegacyLinkDoc(legacyId);
      allow write: if isAdmin();
    }

    match /admin_metrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_crash_reports/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_notifications/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
