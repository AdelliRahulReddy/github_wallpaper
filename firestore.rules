rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.enabled != false;
    }

    function appEmail() {
      return request.auth.token.github_email is string
        ? request.auth.token.github_email
        : request.auth.token.email is string
          ? request.auth.token.email
          : null;
    }

    function isOwnUserDoc(email) {
      return isSignedIn()
        && appEmail() is string
        && appEmail() == email;
    }

    function isAllowedOwnUserCreate(email) {
      return isOwnUserDoc(email)
        && request.resource.data.keys().hasOnly([
          'email',
          'username',
          'plan',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && request.resource.data.plan == 'free';
    }

    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    match /users/{email} {
      allow read: if isAdmin() || isOwnUserDoc(email);
      allow create: if isAdmin() || isAllowedOwnUserCreate(email);
      allow update, delete: if isAdmin();
    }

    match /coupon_codes/{code} {
      allow read, write: if isAdmin();
    }

    match /admin_metrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_crash_reports/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin_notifications/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
